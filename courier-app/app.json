{
  "expo": {
    "name": "Eco-Donation Courier",
    "slug": "courier-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "courierapp",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1D4ED8",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1D4ED8"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Izinkan Eco-Donation Kurir membagikan lokasi Anda kepada pengguna selama menuju titik penjemputan."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
